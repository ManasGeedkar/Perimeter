# PERIMETER Server Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=perimeter_db
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Security, JWT & CORS
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_this_to_a_strong_random_secret_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=perimeter_admin
MINIO_SECRET_KEY=perimeter_minio_secret
MINIO_BUCKET_NAME=perimeter-evidence
